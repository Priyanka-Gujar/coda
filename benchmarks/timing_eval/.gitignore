real_cases/*.html

# Generated evaluation outputs
real_cases_results/
real_cases_results_gptoss/
real_cases_report/

# Legacy synthetic dry-run artifacts (regenerated by run_synthetic_dry_run.py)
audio/
results/
interviews/
dry_run/

# Misc artifacts
*.log
*.zip
*.pptx
.DS_Store
__pycache__/
